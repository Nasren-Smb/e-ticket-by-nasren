<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - E-Ticket IT Helpdesk</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

  <%- include('partials/header') %>

  <main class="container my-5 flex-grow-1">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-lock-fill text-danger me-2"></i>Dashboard Admin</h2>
        <p class="text-muted mb-0">Panel kontrol administrator untuk mengelola master data sistem helpdesk.</p>
      </div>
      <div>
        <span class="badge bg-danger p-2"><i class="bi bi-person-fill-gear me-1"></i>Akses Administrator</span>
      </div>
    </div>

    <% if (flash) { %>
      <div class="alert alert-<%= flash.type === 'danger' ? 'danger' : 'success' %> alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-<%= flash.type === 'danger' ? 'exclamation-triangle-fill' : 'check-circle-fill' %> me-2"></i>
        <%= flash.message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <div class="row g-4">
      <!-- Kartu Modul Pengguna -->
      <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100 border-start border-4 border-primary">
          <div class="card-body p-4 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill">
                  <i class="bi bi-people-fill me-1"></i> Modul Pengguna
                </span>
                <h2 class="fw-bold text-dark mb-0"><%= userCount %></h2>
              </div>
              <h4 class="fw-bold text-dark mb-2">Kelola Pengguna</h4>
              <p class="text-muted mb-4">
                Daftar semua akun terdaftar, pembuatan pengguna baru, pengaturan divisi, penentuan peran (employee, helpdesk, admin), dan atur ulang password.
              </p>
            </div>
            <div>
              <a href="/admin/users" class="btn btn-primary w-100 fw-semibold">
                <i class="bi bi-arrow-right-circle me-1"></i> Buka Manajemen Pengguna
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Kartu Modul Kategori -->
      <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100 border-start border-4 border-success">
          <div class="card-body p-4 d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">
                  <i class="bi bi-tags-fill me-1"></i> Modul Kategori
                </span>
                <h2 class="fw-bold text-dark mb-0"><%= categoryCount %></h2>
              </div>
              <h4 class="fw-bold text-dark mb-2">Kelola Kategori Tiket</h4>
              <p class="text-muted mb-4">
                Master data kategori kendala (Hardware, Jaringan, Software, dll), penambahan kategori baru, ubah nama, dan hapus kategori yang tidak terpakai.
              </p>
            </div>
            <div>
              <a href="/admin/categories" class="btn btn-success w-100 fw-semibold">
                <i class="bi bi-arrow-right-circle me-1"></i> Buka Manajemen Kategori
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
