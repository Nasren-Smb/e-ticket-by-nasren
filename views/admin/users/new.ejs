<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - E-Ticket IT Helpdesk</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

  <%- include('../../partials/header') %>

  <main class="container my-5 flex-grow-1">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a href="/admin" class="text-decoration-none">Admin</a></li>
            <li class="breadcrumb-item"><a href="/admin/users" class="text-decoration-none">Pengguna</a></li>
            <li class="breadcrumb-item active" aria-current="page">Tambah Baru</li>
          </ol>
        </nav>

        <div class="card shadow-sm border-0">
          <div class="card-header bg-white py-3 border-bottom">
            <h4 class="fw-bold mb-0 text-dark">
              <i class="bi bi-person-plus-fill text-primary me-2"></i>Tambah Pengguna Baru
            </h4>
          </div>
          <div class="card-body p-4">
            <form action="/admin/users" method="POST" novalidate>
              <!-- Nama -->
              <div class="mb-3">
                <label for="nama" class="form-label fw-semibold">Nama Lengkap <span class="text-danger">*</span></label>
                <input
                  type="text"
                  class="form-control <%= errors.nama ? 'is-invalid' : '' %>"
                  id="nama"
                  name="nama"
                  placeholder="Contoh: Budi Santoso"
                  value="<%= formData.nama || '' %>"
                  maxlength="100"
                  required
                >
                <% if (errors.nama) { %>
                  <div class="invalid-feedback"><%= errors.nama %></div>
                <% } %>
              </div>

              <!-- Email -->
              <div class="mb-3">
                <label for="email" class="form-label fw-semibold">Email Perusahaan <span class="text-danger">*</span></label>
                <input
                  type="email"
                  class="form-control <%= errors.email ? 'is-invalid' : '' %>"
                  id="email"
                  name="email"
                  placeholder="nama@perusahaan.local"
                  value="<%= formData.email || '' %>"
                  maxlength="150"
                  required
                >
                <% if (errors.email) { %>
                  <div class="invalid-feedback"><%= errors.email %></div>
                <% } %>
              </div>

              <div class="row">
                <!-- Divisi -->
                <div class="col-md-6 mb-3">
                  <label for="divisi" class="form-label fw-semibold">Divisi / Departemen</label>
                  <input
                    type="text"
                    class="form-control <%= errors.divisi ? 'is-invalid' : '' %>"
                    id="divisi"
                    name="divisi"
                    placeholder="Contoh: Keuangan, HRD, IT"
                    value="<%= formData.divisi || '' %>"
                    maxlength="100"
                  >
                  <% if (errors.divisi) { %>
                    <div class="invalid-feedback"><%= errors.divisi %></div>
                  <% } %>
                </div>

                <!-- Peran (Role) -->
                <div class="col-md-6 mb-3">
                  <label for="role" class="form-label fw-semibold">Peran Sistem <span class="text-danger">*</span></label>
                  <select class="form-select <%= errors.role ? 'is-invalid' : '' %>" id="role" name="role" required>
                    <option value="employee" <%= formData.role === 'employee' || !formData.role ? 'selected' : '' %>>Employee (Karyawan)</option>
                    <option value="helpdesk" <%= formData.role === 'helpdesk' ? 'selected' : '' %>>Helpdesk (Petugas IT)</option>
                    <option value="admin" <%= formData.role === 'admin' ? 'selected' : '' %>>Admin (Administrator)</option>
                  </select>
                  <% if (errors.role) { %>
                    <div class="invalid-feedback"><%= errors.role %></div>
                  <% } %>
                </div>
              </div>

              <!-- Password Awal -->
              <div class="mb-4">
                <label for="password" class="form-label fw-semibold">Password Awal <span class="text-danger">*</span></label>
                <input
                  type="password"
                  class="form-control <%= errors.password ? 'is-invalid' : '' %>"
                  id="password"
                  name="password"
                  placeholder="Minimal 8 karakter"
                  maxlength="72"
                  required
                >
                <div class="form-text">Password harus memiliki panjang 8 - 72 karakter.</div>
                <% if (errors.password) { %>
                  <div class="invalid-feedback"><%= errors.password %></div>
                <% } %>
              </div>

              <div class="d-flex justify-content-between align-items-center">
                <a href="/admin/users" class="btn btn-outline-secondary">
                  <i class="bi bi-arrow-left me-1"></i> Batal
                </a>
                <button type="submit" class="btn btn-primary fw-semibold px-4">
                  <i class="bi bi-save me-1"></i> Simpan Pengguna
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

