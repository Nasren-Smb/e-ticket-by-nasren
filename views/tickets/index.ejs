<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - E-Ticket IT Helpdesk</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

  <%- include('../partials/header') %>

  <main class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
      <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-ticket-perforated text-primary me-2"></i>Tiket Saya</h3>
        <p class="text-muted mb-0">Daftar semua permohonan kendala IT yang Anda ajukan.</p>
      </div>
      <a href="/tickets/new" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i> Buat Tiket Baru
      </a>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <% if (!tickets || tickets.length === 0) { %>
          <div class="text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <h5 class="fw-semibold mt-3 text-secondary">Belum ada tiket yang diajukan</h5>
            <p class="text-muted small">Jika Anda mengalami kendala perangkat, jaringan, atau aplikasi, silakan buat tiket baru.</p>
            <a href="/tickets/new" class="btn btn-outline-primary btn-sm mt-2">
              <i class="bi bi-plus-lg me-1"></i> Buat Tiket Sekarang
            </a>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th scope="col" class="ps-4">Kode Tiket</th>
                  <th scope="col">Judul Kendala</th>
                  <th scope="col">Kategori</th>
                  <th scope="col">Prioritas</th>
                  <th scope="col">Status</th>
                  <th scope="col">Tanggal Diajukan</th>
                  <th scope="col" class="text-end pe-4">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% tickets.forEach(ticket => { %>
                  <tr>
                    <td class="ps-4 fw-bold text-primary">
                      <a href="/tickets/<%= ticket.id %>" class="text-decoration-none">
                        <%= ticket.kode %>
                      </a>
                    </td>
                    <td>
                      <span class="fw-semibold"><%= ticket.judul %></span>
                    </td>
                    <td>
                      <span class="badge bg-light text-dark border">
                        <i class="bi bi-tag me-1"></i><%= ticket.category_nama %>
                      </span>
                    </td>
                    <td>
                      <% if (ticket.prioritas === 'Urgent') { %>
                        <span class="badge bg-danger">Urgent</span>
                      <% } else if (ticket.prioritas === 'Tinggi') { %>
                        <span class="badge bg-warning text-dark">Tinggi</span>
                      <% } else if (ticket.prioritas === 'Sedang') { %>
                        <span class="badge bg-info text-dark">Sedang</span>
                      <% } else { %>
                        <span class="badge bg-secondary">Rendah</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (ticket.status === 'Baru') { %>
                        <span class="badge bg-primary">Baru</span>
                      <% } else if (ticket.status === 'Diproses') { %>
                        <span class="badge bg-warning text-dark">Diproses</span>
                      <% } else if (ticket.status === 'Selesai') { %>
                        <span class="badge bg-success">Selesai</span>
                      <% } else { %>
                        <span class="badge bg-secondary">Ditutup</span>
                      <% } %>
                    </td>
                    <td class="text-muted small">
                      <%= new Date(ticket.created_at).toLocaleString('id-ID') %>
                    </td>
                    <td class="text-end pe-4">
                      <a href="/tickets/<%= ticket.id %>" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-eye me-1"></i> Detail
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

