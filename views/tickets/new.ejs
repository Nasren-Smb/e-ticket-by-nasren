<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - E-Ticket IT Helpdesk</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

  <%- include('../partials/header') %>

  <main class="container my-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="d-flex align-items-center mb-3">
          <a href="/tickets" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i> Kembali
          </a>
          <h3 class="fw-bold mb-0"><i class="bi bi-plus-circle text-primary me-2"></i>Form Buat Tiket Baru</h3>
        </div>

        <% if (errors.general) { %>
          <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= errors.general %>
          </div>
        <% } %>

        <div class="card shadow-sm border-0">
          <div class="card-body p-4">
            <form action="/tickets" method="POST" novalidate>
              <!-- Judul Tiket -->
              <div class="mb-3">
                <label for="judul" class="form-label fw-semibold">Judul Kendala <span class="text-danger">*</span></label>
                <input
                  type="text"
                  class="form-control <%= errors.judul ? 'is-invalid' : '' %>"
                  id="judul"
                  name="judul"
                  maxlength="150"
                  value="<%= values.judul %>"
                  placeholder="Contoh: Printer lantai 2 tidak menyala"
                  required
                >
                <% if (errors.judul) { %>
                  <div class="invalid-feedback"><%= errors.judul %></div>
                <% } else { %>
                  <div class="form-text">Maksimal 150 karakter.</div>
                <% } %>
              </div>

              <div class="row">
                <!-- Kategori -->
                <div class="col-md-6 mb-3">
                  <label for="category_id" class="form-label fw-semibold">Kategori <span class="text-danger">*</span></label>
                  <select
                    class="form-select <%= errors.category_id ? 'is-invalid' : '' %>"
                    id="category_id"
                    name="category_id"
                    required
                  >
                    <option value="">-- Pilih Kategori --</option>
                    <% categories.forEach(cat => { %>
                      <option
                        value="<%= cat.id %>"
                        <%= String(values.category_id) === String(cat.id) ? 'selected' : '' %>
                      >
                        <%= cat.nama %>
                      </option>
                    <% }) %>
                  </select>
                  <% if (errors.category_id) { %>
                    <div class="invalid-feedback"><%= errors.category_id %></div>
                  <% } %>
                </div>

                <!-- Prioritas -->
                <div class="col-md-6 mb-3">
                  <label for="prioritas" class="form-label fw-semibold">Tingkat Prioritas <span class="text-danger">*</span></label>
                  <select
                    class="form-select <%= errors.prioritas ? 'is-invalid' : '' %>"
                    id="prioritas"
                    name="prioritas"
                    required
                  >
                    <option value="Rendah" <%= values.prioritas === 'Rendah' ? 'selected' : '' %>>Rendah</option>
                    <option value="Sedang" <%= values.prioritas === 'Sedang' ? 'selected' : '' %>>Sedang</option>
                    <option value="Tinggi" <%= values.prioritas === 'Tinggi' ? 'selected' : '' %>>Tinggi</option>
                    <option value="Urgent" <%= values.prioritas === 'Urgent' ? 'selected' : '' %>>Urgent</option>
                  </select>
                  <% if (errors.prioritas) { %>
                    <div class="invalid-feedback"><%= errors.prioritas %></div>
                  <% } %>
                </div>
              </div>

              <!-- Deskripsi Kendala -->
              <div class="mb-4">
                <label for="deskripsi" class="form-label fw-semibold">Deskripsi Kendala <span class="text-danger">*</span></label>
                <textarea
                  class="form-control <%= errors.deskripsi ? 'is-invalid' : '' %>"
                  id="deskripsi"
                  name="deskripsi"
                  rows="5"
                  maxlength="2000"
                  placeholder="Jelaskan detail kendala yang Anda alami secara rinci..."
                  required
                ><%= values.deskripsi %></textarea>
                <% if (errors.deskripsi) { %>
                  <div class="invalid-feedback"><%= errors.deskripsi %></div>
                <% } else { %>
                  <div class="form-text">Maksimal 2000 karakter.</div>
                <% } %>
              </div>

              <div class="d-flex justify-content-end gap-2">
                <a href="/tickets" class="btn btn-light border">Batal</a>
                <button type="submit" class="btn btn-primary px-4">
                  <i class="bi bi-send me-1"></i> Kirim Tiket
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

