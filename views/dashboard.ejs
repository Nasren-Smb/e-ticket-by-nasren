<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - E-Ticket IT Helpdesk</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100 bg-light">

  <%- include('partials/header') %>

  <main class="container my-5">
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
          <div>
            <h3 class="fw-bold mb-1">Selamat Datang, <%= user.nama %>!</h3>
            <p class="text-muted mb-0">Anda masuk dengan peran (role): <span class="badge bg-primary text-uppercase"><%= user.role %></span></p>
          </div>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="btn btn-outline-danger">
              <i class="bi bi-shield-lock me-1"></i> Buka Halaman Admin
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <h5 class="card-title text-primary"><i class="bi bi-person-badge me-2"></i>Informasi Sesi Pengguna</h5>
            <ul class="list-group list-group-flush mt-3">
              <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">User ID:</span>
                <strong><%= user.id %></strong>
              </li>
              <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Nama Lengkap:</span>
                <strong><%= user.nama %></strong>
              </li>
              <li class="list-group-item d-flex justify-content-between px-0">
                <span class="text-muted">Role:</span>
                <span class="badge bg-secondary"><%= user.role %></span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
          <div class="card-body">
            <h5 class="card-title text-success"><i class="bi bi-check2-circle me-2"></i>Status Tahapan</h5>
            <p class="text-muted mt-3">
              Autentikasi session dan pembagian peran telah aktif (Tahap 03).
              Menu tiket untuk karyawan, helpdesk, dan manajemen admin akan dikembangkan pada tahap selanjutnya.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

